<Window x:Class="CodexRtlManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GptGate RTL" Icon="Resources/gptgate-logo.png"
        Height="645" Width="960" MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" FlowDirection="LeftToRight"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="92" />
        </Grid.RowDefinitions>

        <!-- Compact brand title bar. -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="12,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="—"
                            Click="MinimizeButton_Click" AutomationProperties.Name="کمینه کردن" />
                    <Button Style="{StaticResource CaptionButton}" Content="□"
                            Click="MaximizeButton_Click" AutomationProperties.Name="بزرگ کردن" />
                    <Button Style="{StaticResource CaptionButton}" Content="×"
                            Click="CloseButton_Click" AutomationProperties.Name="بستن برنامه" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource AppFontExtraBold}" FontSize="15"
                               FontWeight="ExtraBold" Margin="0,0,9,0" VerticalAlignment="Center"
                               FlowDirection="RightToLeft">
                        <Run Text="جی‌پی‌تی گیت " Foreground="{StaticResource TextBrush}" />
                        <Run Text="RTL" Foreground="{StaticResource AccentBrush}" />
                    </TextBlock>
                    <Image Source="Resources/gptgate-logo.png" Width="32" Height="32" Stretch="Uniform" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Native utility rows: status, font, update. -->
        <Grid Grid.Row="1" Margin="28,22,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="132" />
                <RowDefinition Height="1" />
                <RowDefinition Height="112" />
                <RowDefinition Height="1" />
                <RowDefinition Height="96" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource BaseButton}" Content="بررسی دوباره"
                        Click="RefreshButton_Click" MinWidth="132" Padding="16,9"
                        VerticalAlignment="Center" AutomationProperties.Name="بررسی دوباره وضعیت ChatGPT" />

                <Border Grid.Column="2" Background="{StaticResource ElevatedBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="18,10" VerticalAlignment="Center">
                    <TextBlock x:Name="InstallTypeText" Text="—" FontFamily="Segoe UI"
                               FontSize="12" Foreground="{StaticResource TextBrush}"
                               FlowDirection="LeftToRight" />
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="نسخه" FontFamily="{StaticResource AppFont}" FontSize="11"
                               Foreground="{StaticResource SubtleBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="CodexVersionText" Text="—" FontFamily="Segoe UI"
                               FontSize="12" Foreground="{StaticResource TextBrush}"
                               FlowDirection="LeftToRight" />
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"
                            FlowDirection="RightToLeft">
                    <Ellipse x:Name="StatusDot" Width="38" Height="38" Fill="#727272"
                             Margin="0,0,20,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="در حال بررسی…"
                                   FontFamily="{StaticResource AppFontExtraBold}"
                                   FontSize="24" FontWeight="ExtraBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="StatusDetails" Text="لطفاً کمی صبر کن."
                                   FontFamily="{StaticResource AppFont}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                                   TextWrapping="Wrap" MaxWidth="330" />
                        <TextBlock x:Name="ProgressText" FontFamily="{StaticResource AppFont}"
                                   Margin="0,4,0,0" Foreground="{StaticResource SubtleBrush}"
                                   FontSize="10" TextWrapping="Wrap" MaxWidth="330"
                                   FlowDirection="RightToLeft" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SelectFontButton" Grid.Column="0" Style="{StaticResource BaseButton}"
                        Content="انتخاب فونت…" Click="SelectFontButton_Click"
                        MinWidth="138" Padding="16,9" VerticalAlignment="Center" />
                <Button x:Name="ResetFontButton" Grid.Column="2" Style="{StaticResource BaseButton}"
                        Content="بازگشت به Arad" Click="ResetFontButton_Click"
                        MinWidth="148" Padding="16,9" VerticalAlignment="Center" />

                <TextBlock x:Name="FontNameText" Grid.Column="4" Text="Arad"
                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                           FlowDirection="LeftToRight" />
                <TextBlock Grid.Column="6" Text="فونت متن فارسی"
                           FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                           FlowDirection="RightToLeft" />
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource BorderBrush}" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="UpdateButton" Grid.Column="0" Style="{StaticResource BaseButton}"
                        Content="بررسی بروزرسانی" Click="UpdateButton_Click"
                        MinWidth="150" Padding="16,9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="بررسی بروزرسانی"
                           FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                           FlowDirection="RightToLeft" />
            </Grid>

            <Border Grid.Row="5" Background="{StaticResource BorderBrush}" />

            <StackPanel Grid.Row="6" VerticalAlignment="Bottom" Margin="0,0,0,18">
                <ProgressBar x:Name="WorkProgress" Height="3" IsIndeterminate="True"
                             Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource ElevatedBrush}" />
            </StackPanel>
        </Grid>

        <!-- Fixed action rail. -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PersistentButton" Grid.Column="0" Style="{StaticResource BaseButton}"
                        Content="فعال‌سازی RTL دائمی" Click="PersistentButton_Click"
                        AutomationProperties.Name="فعال‌سازی یا غیرفعال‌سازی RTL دائمی"
                        MinWidth="220" VerticalAlignment="Center" />
                <Button x:Name="RestartButton" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        Content="اجرای ChatGPT با RTL" Click="RestartButton_Click"
                        MinWidth="240" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
