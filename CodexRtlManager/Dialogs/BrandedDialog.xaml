<Window x:Class="CodexRtlManager.Dialogs.BrandedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="پیام جی‌پی‌تی گیت"
        Width="540" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource TextBrush}" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        automation:AutomationProperties.Name="پیام جی‌پی‌تی گیت">
    <Border Margin="18" Padding="0" CornerRadius="22"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/GptGateRTL;component/Resources/gptgate-logo.png"
                           Width="32" Height="32" Stretch="Uniform" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFontExtraBold}"
                               FontSize="15" FontWeight="ExtraBold">
                        <Run Text="جی‌پی‌تی " Foreground="{StaticResource TextBrush}" />
                        <Run Text="گیت" Foreground="{StaticResource PersianWordmarkGradient}" />
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource NavButton}"
                        Content="بستن" Click="CloseButton_Click"
                        Padding="12,7" MinWidth="64"
                        automation:AutomationProperties.Name="بستن پنجره" />
            </Grid>

            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,1" Padding="28,26,28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ToneBar" CornerRadius="2"
                            Background="{StaticResource AccentBrush}" />

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="DialogTitle" FontSize="22" FontWeight="ExtraBold"
                                   FontFamily="{StaticResource AppFontExtraBold}"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" LineHeight="34" />
                        <TextBlock x:Name="DialogMessage" Margin="0,12,0,0"
                                   FontSize="13" LineHeight="24"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="28,20,28,24">
                <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryButton}"
                        Click="PrimaryAction_Click" IsDefault="True"
                        MinWidth="190"
                        automation:AutomationProperties.Name="تأیید" />
                <Button x:Name="SecondaryAction" Style="{StaticResource BaseButton}"
                        Click="SecondaryAction_Click" IsCancel="True"
                        Margin="10,0,0,0" MinWidth="110"
                        automation:AutomationProperties.Name="انصراف" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
